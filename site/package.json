{
  "name": "liberteministries.org",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "astro build && node scripts/check-site.mjs",
    "check:site": "node scripts/check-site.mjs",
    "lint": "prettier --ignore-path ../.prettierignore --check . ../README.md ../.github/workflows ../.prettierrc.json",
    "fmt": "prettier --ignore-path ../.prettierignore --write . ../README.md ../.github/workflows ../.prettierrc.json"
  },
  "dependencies": {
    "astro": "7.4.11"
  },
  "devDependencies": {
    "parse5": "8.1.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2"
  }
}
