---
import newsletter from "../data/newsletter.json";
---

<div id="mc_embed_shell">
  <div id="mc_embed_signup">
    <form
      id="mc-embedded-subscribe-form"
      name="mc-embedded-subscribe-form"
      class="validate mc4wp-form native-newsletter"
      action={newsletter.formAction}
      method="post"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Newsletter signup"
    >
      <div id="mc_embed_signup_scroll" class="mc4wp-form-fields">
        <div class="mc-field-group">
          <label for="mce-EMAIL">Email address (required)</label>
          <input
            id="mce-EMAIL"
            type="email"
            name="EMAIL"
            class="required email"
            placeholder="Your email address"
            autocomplete="email"
            required
            value=""
          />
        </div>
        <div class="mc-field-group">
          <label for="mce-FNAME">First name (optional)</label>
          <input
            id="mce-FNAME"
            type="text"
            name="FNAME"
            class="text"
            autocomplete="given-name"
            value=""
          />
        </div>
        <div class="mc-field-group">
          <label for="mce-LNAME">Last name (optional)</label>
          <input
            id="mce-LNAME"
            type="text"
            name="LNAME"
            class="text"
            autocomplete="family-name"
            value=""
          />
        </div>
        <input
          type="hidden"
          name="MMERGE5"
          value="I want to subscribe to the Newsletter"
        />
        <div id="mce-responses" class="clear" aria-live="polite">
          <div
            class="response"
            id="mce-error-response"
            style="display: none;"
          ></div>
          <div
            class="response"
            id="mce-success-response"
            style="display: none;"
          ></div>
        </div>
        <div class="newsletter-trap" aria-hidden="true">
          <input
            type="text"
            name={newsletter.honeypotField}
            value=""
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <div class="clear">
          <input
            type="submit"
            name="subscribe"
            id="mc-embedded-subscribe"
            class="button"
            value="Sign up"
          />
        </div>
      </div>
    </form>
  </div>
  <script
    is:inline
    src="https://s3.amazonaws.com/downloads.mailchimp.com/js/mc-validate.js"
  ></script>
  <script is:inline>
    // Mailchimp's email-field setup; the supplied SMS helpers have no SMS fields here.
    // If the script is unavailable, the form can still POST directly to Mailchimp.
    if (window.jQuery) {
      window.fnames = [];
      window.ftypes = [];
      window.fnames[0] = "EMAIL";
      window.ftypes[0] = "email";
      window.fnames[1] = "FNAME";
      window.ftypes[1] = "text";
      window.fnames[2] = "LNAME";
      window.ftypes[2] = "text";
      window.fnames[5] = "MMERGE5";
      window.ftypes[5] = "dropdown";
      window.$mcj = window.jQuery.noConflict(true);
    }
  </script>
</div>
