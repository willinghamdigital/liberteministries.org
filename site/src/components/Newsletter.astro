---
import newsletter from "../data/newsletter.json";
---

<form
  class="mc4wp-form native-newsletter"
  action={newsletter.formAction}
  method="post"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Newsletter signup"
>
  <input type="hidden" name="u" value={newsletter.userId} />
  <input type="hidden" name="id" value={newsletter.audienceId} />
  <input
    type="hidden"
    name="MERGE5"
    value="I want to subscribe to the Newsletter"
  />
  <div class="mc4wp-form-fields">
    <p>
      <label for="newsletter-email" class="screen-reader-text">
        Your email address
      </label>
      <input
        id="newsletter-email"
        type="email"
        name="MERGE0"
        placeholder="Your email address"
        autocomplete="email"
        required
      />
    </p>
    <p>
      <input type="submit" value="Sign up" />
    </p>
    <div class="newsletter-trap" aria-hidden="true">
      <input
        type="text"
        name="b_name"
        value=""
        tabindex="-1"
        autocomplete="off"
      />
      <input
        type="email"
        name="b_email"
        value=""
        tabindex="-1"
        autocomplete="off"
      />
    </div>
  </div>
</form>
