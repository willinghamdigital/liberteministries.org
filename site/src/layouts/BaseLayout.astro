---
import "../styles/native.css";
import Newsletter from "../components/Newsletter.astro";
import wordpress from "../data/wordpress.json";
import bundle from "../data/wordpress-styles.json";
import { renderWordpress } from "../lib/wordpress.mjs";
import { url } from "../lib/links";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  source?: { path: string; bodyClass: string; styles?: string[] };
}
const {
  title,
  description = "Making disciples, building communities, and supporting education. Liberté Ministries serves alongside our brothers and sisters in Haiti.",
  image = "/images/IMG_7055-scaled.jpg",
  noindex = false,
  source,
} = Astro.props;
const route =
  source?.path ?? Astro.url.pathname.slice(import.meta.env.BASE_URL.length);
const canonical = new URL(
  noindex ? url("404.html") : Astro.url.pathname,
  Astro.site,
);
const styles = bundle.pageStyles[source?.path || ""] || bundle.pageStyles[""];
const footer = renderWordpress(
  wordpress.footerBeforeNewsletter +
    "__NATIVE_NEWSLETTER__" +
    wordpress.footerAfterNewsletter,
  route,
);
const [footerBefore, footerAfter] = footer.split("__NATIVE_NEWSLETTER__");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - Liberte Ministries</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={`${title} - Liberte Ministries`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url(image), Astro.site)} />
    <link rel="icon" href={url("images/lm-logo.png")} type="image/png" />
    {styles.map((style) => (
      <link rel="stylesheet" href={url(style)} />
    ))}
    <script is:inline>
      if (
        "IntersectionObserver" in window &&
        !matchMedia("(prefers-reduced-motion: reduce)").matches
      )
        document.documentElement.classList.add("motion-ready");
    </script>
  </head>
  <body
    class={
      source?.bodyClass ||
      "elementor-default elementor-template-full-width elementor-kit-10"
    }
  >
    <a class="skip-link screen-reader-text" href="#content">
      Skip to content
    </a>
    <Fragment set:html={renderWordpress(wordpress.header, route)} />
    <main id="content">
      <slot />
    </main>
    <Fragment set:html={footerBefore} />
    <Newsletter />
    <Fragment set:html={footerAfter} />
    <dialog id="mobile-menu" class="native-menu" aria-label="Main navigation">
      <button type="button" class="native-menu-close" aria-label="Close menu">
        ×
      </button>
      <Fragment set:html={renderWordpress(wordpress.mobileMenu, route)} />
    </dialog>
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
