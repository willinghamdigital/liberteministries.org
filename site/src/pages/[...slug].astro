---
import BaseLayout from "../layouts/BaseLayout.astro";
import wordpress from "../data/wordpress.json";
import posts from "../data/wordpress-posts.json";
import { renderWordpress } from "../lib/wordpress.mjs";
export function getStaticPaths() {
  return [...wordpress.pages, ...posts.pages]
    .filter((page) => page.path)
    .map((page) => ({
      params: { slug: page.path.replace(/^\/+|\/+$/g, "") },
      props: { page },
    }));
}
const { page } = Astro.props;
---

<BaseLayout title={page.title} source={page}>
  <Fragment set:html={renderWordpress(page.html, page.path)} />
</BaseLayout>
