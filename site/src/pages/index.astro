---
import BaseLayout from "../layouts/BaseLayout.astro";
import wordpress from "../data/wordpress.json";
import { renderWordpress } from "../lib/wordpress.mjs";
const source = wordpress.pages.find((page) => page.path === "")!;
---

<BaseLayout title="Home" source={source}>
  <Fragment set:html={renderWordpress(source.html)} />
</BaseLayout>
