---
import BaseLayout from "../layouts/BaseLayout.astro";
import content from "../data/content.json";
import { url } from "../lib/links";
const assets = content.assets;
const ministries = [
  {
    title: "Harry’s Home",
    image: assets.harrysHome,
    description: "Children’s home providing spiritual and physical needs.",
    path: "ministries/harrys-home/",
  },
  {
    title: "Haiti School of Biblical Studies",
    image: assets.hsbs,
    description: "College program providing a 4-year Biblical education.",
    path: "ministries/hsbs/",
  },
  {
    title: "Bonnette Primary School",
    image: assets.school,
    description: "Primary school serving 400+ children.",
    path: "ministries/school/",
  },
];
const actions = [
  {
    title: "Pray",
    text: "Join us in prayer for our brothers and sisters.",
    label: "Learn more",
    path: "about/",
  },
  {
    title: "Give",
    text: "Give a one-time gift or set up recurring support.",
    label: "Donate",
    path: "donations/",
  },
  {
    title: "Go",
    text: "Learn about serving alongside our friends in Haiti.",
    label: "Explore trips",
    path: "trips/",
  },
  {
    title: "Support",
    text: "Support Liberté by becoming a church partner.",
    label: "Learn more",
    path: "about/mobilize-your-church/",
  },
];
---

<BaseLayout title="Home">
  <section class="hero">
    <img
      class="hero-image"
      src={url(assets.hero)}
      alt="Children gathered in Haiti"
      width="1920"
      height="1280"
      fetchpriority="high"
    />
    <div class="container hero-content">
      <p class="eyebrow">Welcome to Liberté Ministries</p>
      <h1>
        Making Disciples
        <br />
        Building Communities
        <br />
        Supporting Education.
      </h1>
      <p>
        We have been blessed so richly through Christ and the freedom we have in
        Him. As we strive to teach and be workers of the Gospel, one key theme
        runs through our work, freedom.
      </p>
      <a class="button" href={url("about/")}>
        Discover more <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
  <section class="container ministry-cards" aria-label="Our ministries">
    {ministries.map((ministry) => (
      <a class="ministry-card" href={url(ministry.path)}>
        <img src={url(ministry.image)} alt="" width="220" height="220" />
        <h2>{ministry.title}</h2>
        <p>{ministry.description}</p>
        <span class="text-link">
          Learn more <span aria-hidden="true">→</span>
        </span>
      </a>
    ))}
  </section>
  <section class="section mission">
    <div class="container two-columns">
      <img
        class="mission-image"
        src={url(assets.mission)}
        alt="Children supported by Liberté Ministries"
        width="680"
        height="680"
        loading="lazy"
      />
      <div>
        <p class="eyebrow">Our mission</p>
        <h2>
          Freedom. Faith.
          <br />A future together.
        </h2>
        <p>
          By partnering with local Churches, Liberté Ministries focuses on
          building long-term relationships with our brothers and sisters abroad.
          Through these relationships, we work alongside our brothers and
          sisters to be a resource where needed.
        </p>
        <ul class="mission-values">
          <li>Freedom in Christ</li>
          <li>Freedom in Education</li>
          <li>Freedom in Economic Self-Sufficiency</li>
        </ul>
        <a class="button" href={url("about/")}>
          Discover our mission <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
  <section class="section container testimonials">
    <p class="eyebrow">Our testimonials</p>
    <h2>What they say</h2>
    <div class="quotes">
      <figure>
        <blockquote>
          “Through the eyes of children you see love and laughter. Children are
          a gift from the LORD; they are a reward from Him.”
        </blockquote>
        <figcaption>— Mona</figcaption>
      </figure>
      <figure>
        <blockquote>
          “Through Liberté Ministries I have been able to serve and form lasting
          relationships in ways that I would have never had the opportunity to
          do otherwise.”
        </blockquote>
        <figcaption>— Thomas</figcaption>
      </figure>
      <figure>
        <blockquote>
          “Once you visit you leave part of your heart there with the people,
          especially the children.”
        </blockquote>
        <figcaption>— Arvy</figcaption>
      </figure>
    </div>
  </section>
  <section class="section take-action">
    <div class="container">
      <p class="eyebrow">Take action</p>
      <h2>What part will you play?</h2>
      <div class="action-grid">
        {actions.map((action) => (
          <div>
            <h3>{action.title}</h3>
            <p>{action.text}</p>
            <a class="text-link" href={url(action.path)}>
              {action.label} <span aria-hidden="true">→</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
