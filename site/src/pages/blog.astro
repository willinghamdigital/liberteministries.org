---
import BaseLayout from "../layouts/BaseLayout.astro";
import content from "../data/content.json";
import { url } from "../lib/links";
const posts = [...content.posts].sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout
  title="News & newsletters"
  description="Read updates and newsletters from Liberté Ministries and our work alongside communities in Haiti."
>
  <div class="page-heading">
    <div class="container">
      <p class="eyebrow">From the field</p>
      <h1>News & newsletters</h1>
      <p>Stories, updates, and letters from our work in Haiti.</p>
    </div>
  </div>
  <section class="container news-list" aria-label="News archive">
    {posts.map((post) => (
      <article class="news-item">
        <time datetime={post.date}>
          {new Date(post.date).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
            timeZone: "UTC",
          })}
        </time>
        <h2>
          <a href={url(post.path)}>{post.title}</a>
        </h2>
        <a
          class="text-link"
          href={url(post.path)}
          aria-label={`Read ${post.title}`}
        >
          Read update <span aria-hidden="true">→</span>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>
